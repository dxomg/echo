<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Echo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">
            @color/amoled_bg
        </item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">
            @drawable/art_splash_anim
        </item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">900</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="TIRAMISU">
            icon_preferred
        </item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="s">
            @drawable/art_brand
        </item>
        <item name="android:colorBackground">?echoBackground</item>
        <item name="android:dialogTheme">@style/EchoDialog</item>
        <item name="alertDialogTheme">@style/EchoAlertDialog</item>
        <item name="actionButtonStyle">@style/EchoActionButton</item>
        <item name="buttonStyle">@style/EchoButton</item>

        <item name="colorPrimary">@color/app_color</item>
        <item name="colorPrimaryDark">@color/app_color_shadow</item>
        <item name="colorAccent">@color/app_color</item>
        <item name="colorSurface">@color/amoled_bg</item>
        <item name="colorSurfaceContainer">@color/amoled_bg</item>
        <item name="colorSurfaceContainerLowest">@color/amoled_bg</item>
        <item name="colorSurfaceContainerLow">@color/amoled_bg</item>
        <item name="colorSurfaceContainerHigh">@color/amoled_bg</item>
        <item name="colorSurfaceContainerHighest">@color/amoled_bg</item>
        <item name="colorOnSurface">@color/amoled_fg</item>
        <item name="colorOnSurfaceVariant">@color/amoled_fg</item>
        <item name="colorOnSecondary">@color/amoled_fg</item>
        <item name="colorOutline">@color/amoled_fg_semi</item>
        <item name="colorOutlineVariant">@color/amoled_fg_semi</item>
        <item name="colorTertiary">@color/app_color</item>
        <item name="colorPrimaryContainer">@color/app_color_highlight</item>
        <item name="colorSecondaryContainer">@color/app_color_highlight</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="echoBackground">@color/amoled_bg</item>
        <item name="navBackground">@color/amoled_bg</item>

        <item name="itemCoverSize">96dp</item>
        <item name="itemCorner">8dp</item>
    </style>

    <style name="Default" parent="Base.Theme.Echo">
        <item name="navBarForeground">?colorAccent</item>
        <item name="navBarBackground">@color/app_color_highlight</item>
    </style>

    <style name="Amoled" parent="Default">
        <item name="echoBackground">@color/amoled_bg</item>
        <item name="navBackground">@color/amoled_bg</item>
    </style>

    <style name="BigCover" parent="Default">
        <item name="itemCoverSize">128dp</item>
    </style>

    <style name="AmoledBigCover" parent="Amoled">
        <item name="itemCoverSize">128dp</item>
    </style>
</resources>
