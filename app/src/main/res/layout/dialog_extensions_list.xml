<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:background="@null"
            android:paddingStart="0dp"
            android:paddingEnd="4dp"
            app:menu="@menu/settings_menu"
            app:navigationIcon="@drawable/ic_close"
            app:title="@string/extensions"
            app:titleCentered="true" />

        <dev.brahmkshatriya.echo.utils.ui.legacy.EchoCircularProgressBar
            android:id="@+id/progressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButtonToggleGroup
            android:id="@+id/buttonToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            app:selectionRequired="true" />

        <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButtonGroup
            style="@style/EchoButtonGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal"
            app:spacing="4dp">

            <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButton
                android:id="@+id/manageExtension"
                style="@style/EchoButtonTonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="64dp"
                android:text="@string/manage"
                app:icon="@drawable/ic_extension" />

            <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButton
                android:id="@+id/addExtension"
                style="@style/EchoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="64dp"
                android:text="@string/add"
                app:icon="@drawable/ic_add_circle" />

        </dev.brahmkshatriya.echo.utils.ui.legacy.EchoButtonGroup>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
