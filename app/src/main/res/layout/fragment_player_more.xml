<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:translationY="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="@dimen/player_more_top_margin"
        android:layout_marginBottom="-2dp">

        <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButtonToggleGroup
            android:id="@+id/buttonToggleGroupBg"
            style="@style/PlayerMoreToggleGroup"
            android:alpha="0">

            <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButton style="@style/PlayerMoreBackgroundButton" />

            <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButton style="@style/PlayerMoreBackgroundButton" />

            <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButton style="@style/PlayerMoreBackgroundButton" />
        </dev.brahmkshatriya.echo.utils.ui.legacy.EchoButtonToggleGroup>

        <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButtonToggleGroup
            android:id="@+id/buttonToggleGroup"
            style="@style/PlayerMoreToggleGroup">

            <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButton
                android:id="@+id/queue"
                style="@style/PlayerMoreSelected"
                android:text="@string/up_next" />

            <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButton
                android:id="@+id/lyrics"
                style="@style/PlayerMoreSelected"
                android:text="@string/lyrics"
                app:backgroundTint="@color/button_player_more" />

            <dev.brahmkshatriya.echo.utils.ui.legacy.EchoButton
                android:id="@+id/info"
                style="@style/PlayerMoreSelected"
                android:text="@string/info" />
        </dev.brahmkshatriya.echo.utils.ui.legacy.EchoButtonToggleGroup>
    </FrameLayout>

    <dev.brahmkshatriya.echo.utils.ui.legacy.EchoCardView
        android:id="@+id/viewCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:clipToPadding="false"
        android:padding="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:contentPadding="0dp"
        app:cardCornerRadius="8dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/player_more_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout="@layout/fragment_player_queue" />
    </dev.brahmkshatriya.echo.utils.ui.legacy.EchoCardView>
</LinearLayout>
