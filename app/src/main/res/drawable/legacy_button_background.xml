<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/amoled_fg_semi" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/app_color_highlight" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_checked="true">
        <shape><solid android:color="@color/app_color" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/amoled_fg_semi" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
